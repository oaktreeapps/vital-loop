[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "pain_step_1_body_area",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
      "theme": {
        "$include": "../shared/theme.json"
      }
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "pain_step_1_body_area",
      "path": "/",
      "value": {
        "bodyAreas": []
      }
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "pain_step_1_body_area",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "align": "stretch",
          "children": [
            "progress_row",
            "progress_divider",
            "title",
            "subtitle",
            "map_card",
            "next"
          ]
        },
        {
          "id": "progress_row",
          "component": "Row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            "step_label",
            "section_label"
          ]
        },
        {
          "id": "step_label",
          "component": "Text",
          "variant": "caption",
          "text": "Step 1 of 3"
        },
        {
          "id": "section_label",
          "component": "Text",
          "variant": "caption",
          "text": "Body area"
        },
        {
          "id": "progress_divider",
          "component": "Divider"
        },
        {
          "id": "title",
          "component": "Text",
          "variant": "h2",
          "text": "Where does it hurt?"
        },
        {
          "id": "subtitle",
          "component": "Text",
          "variant": "body",
          "text": "Tap every area that hurts. Switch between front and back."
        },
        {
          "id": "map_card",
          "component": "Card",
          "child": "body_map"
        },
        {
          "id": "body_map",
          "component": "BodyMapPicker",
          "value": {
            "path": "/bodyAreas"
          }
        },
        {
          "id": "next",
          "component": "Button",
          "variant": "primary",
          "child": "next_content",
          "action": {
            "event": {
              "name": "bodyAreasSelected",
              "context": {
                "bodyAreas": {
                  "path": "/bodyAreas"
                }
              }
            }
          },
          "checks": [
            {
              "condition": {
                "call": "required",
                "args": {
                  "value": {
                    "path": "/bodyAreas"
                  }
                },
                "returnType": "boolean"
              },
              "message": "Tap at least one area"
            }
          ]
        },
        {
          "id": "next_content",
          "component": "Row",
          "justify": "center",
          "align": "center",
          "children": [
            "next_label",
            "next_icon"
          ]
        },
        {
          "id": "next_label",
          "component": "Text",
          "text": {
            "call": "formatString",
            "args": {
              "value": "Continue · ${length(value:${/bodyAreas})} ${pluralize(value:${length(value:${/bodyAreas})}, one:'area', other:'areas')}"
            },
            "returnType": "string"
          }
        },
        {
          "id": "next_icon",
          "component": "Icon",
          "name": "arrowForward"
        }
      ]
    }
  }
]