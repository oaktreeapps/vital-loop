[
  {
    "version": "v0.9",
    "deleteSurface": {
      "surfaceId": "medication_step_1_name"
    }
  },
  {
    "version": "v0.9",
    "deleteSurface": {
      "surfaceId": "medication_step_2_dose_schedule"
    }
  },
  {
    "version": "v0.9",
    "deleteSurface": {
      "surfaceId": "medication_step_3_notes"
    }
  },
  {
    "version": "v0.9",
    "deleteSurface": {
      "surfaceId": "medication_summary"
    }
  },
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "medication_step_1_name",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
      "theme": {
        "$include": "../shared/theme.json"
      }
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "medication_step_1_name",
      "path": "/",
      "value": {
        "medicineChoice": [],
        "medicineOther": ""
      }
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "medication_step_1_name",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "align": "stretch",
          "children": [
            "progress_row",
            "progress_divider",
            "eyebrow",
            "title",
            "subtitle",
            "suggestions_label",
            "picked",
            "other_card",
            "tip_card",
            "next"
          ]
        },
        {
          "id": "progress_row",
          "component": "Row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            "step_label",
            "section_label"
          ]
        },
        {
          "id": "step_label",
          "component": "Text",
          "variant": "caption",
          "text": "Step 1 of 3"
        },
        {
          "id": "section_label",
          "component": "Text",
          "variant": "caption",
          "text": "Medicine"
        },
        {
          "id": "progress_divider",
          "component": "Divider"
        },
        {
          "id": "eyebrow",
          "component": "Text",
          "variant": "h4",
          "text": "LOG A MEDICATION"
        },
        {
          "id": "title",
          "component": "Text",
          "variant": "h2",
          "text": "Which medication are you logging?"
        },
        {
          "id": "subtitle",
          "component": "Text",
          "variant": "body",
          "text": "Pick from one of the options below, or type in your medication name"
        },
        {
          "id": "suggestions_label",
          "component": "Text",
          "variant": "h4",
          "text": "COMMON MEDICINES"
        },
        {
          "id": "picked",
          "component": "ChoicePicker",
          "variant": "mutuallyExclusive",
          "displayStyle": "chips",
          "value": {
            "path": "/medicineChoice"
          },
          "options": {
            "$ai": "6 common medicines people log at home: a mix of everyday ones (pain relief, fever, allergy, vitamins) and common long-term ones. Generic names only, no doses. Pick a different, varied set each time.",
            "example": [
              {
                "label": "Paracetamol",
                "value": "Paracetamol"
              },
              {
                "label": "Ibuprofen",
                "value": "Ibuprofen"
              },
              {
                "label": "Vitamin D",
                "value": "Vitamin D"
              },
              {
                "label": "Metformin",
                "value": "Metformin"
              },
              {
                "label": "Amlodipine",
                "value": "Amlodipine"
              },
              {
                "label": "Cetirizine",
                "value": "Cetirizine"
              }
            ]
          }
        },
        {
          "id": "other_card",
          "component": "Card",
          "child": "other_content"
        },
        {
          "id": "other_content",
          "component": "Column",
          "align": "stretch",
          "children": [
            "other_title",
            "other"
          ]
        },
        {
          "id": "other_title",
          "component": "Text",
          "variant": "h5",
          "text": "Something else?"
        },
        {
          "id": "other",
          "component": "TextField",
          "label": "e.g. Omeprazole",
          "value": {
            "path": "/medicineOther"
          }
        },
        {
          "id": "tip_card",
          "component": "Card",
          "child": "tip_row"
        },
        {
          "id": "tip_row",
          "component": "Row",
          "align": "center",
          "children": [
            "tip_icon",
            "tip_text"
          ]
        },
        {
          "id": "tip_icon",
          "component": "IconBadge",
          "name": "lightbulb",
          "color": "#8A5A2B",
          "background": "#F4F0EA",
          "size": 36
        },
        {
          "id": "tip_text",
          "component": "Text",
          "variant": "body",
          "weight": 1,
          "text": "Next, you will add the dose and time"
        },
        {
          "id": "next",
          "component": "Button",
          "variant": "primary",
          "child": "next_content",
          "action": {
            "event": {
              "name": "medicineNameEntered",
              "context": {
                "medicineName": {
                  "call": "formatString",
                  "args": {
                    "value": "${pluralize(value:${length(value:${/medicineOther})}, zero:'${/medicineChoice/0}', other:'${/medicineOther}')}"
                  },
                  "returnType": "string"
                }
              }
            }
          },
          "checks": [
            {
              "condition": {
                "call": "regex",
                "args": {
                  "value": {
                    "call": "formatString",
                    "args": {
                      "value": "${length(value:${/medicineChoice})}${/medicineOther}"
                    },
                    "returnType": "string"
                  },
                  "pattern": "^(?!0\\s*$)."
                },
                "returnType": "boolean"
              },
              "message": "Pick or type a medicine"
            }
          ]
        },
        {
          "id": "next_content",
          "component": "Row",
          "justify": "center",
          "align": "center",
          "children": [
            "next_label",
            "next_icon"
          ]
        },
        {
          "id": "next_label",
          "component": "Text",
          "text": "Continue"
        },
        {
          "id": "next_icon",
          "component": "Icon",
          "name": "arrowForward"
        }
      ]
    }
  }
]
