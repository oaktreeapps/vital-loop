[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "nutrition_step_2_food_items",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
      "theme": {
        "$include": "../shared/theme.json"
      }
    }
  },
  {
    "version": "v0.9",
    "updateDataModel": {
      "surfaceId": "nutrition_step_2_food_items",
      "path": "/",
      "value": {
        "foodItems": [],
        "otherFood": ""
      }
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "nutrition_step_2_food_items",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "align": "stretch",
          "children": [
            "progress_row",
            "progress_divider",
            "meal_tag",
            "title",
            "subtitle",
            "suggestions_header",
            "picked",
            "other_card",
            "next"
          ]
        },
        {
          "id": "progress_row",
          "component": "Row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            "step_label",
            "section_label"
          ]
        },
        {
          "id": "step_label",
          "component": "Text",
          "variant": "caption",
          "text": "Step 2 of 5"
        },
        {
          "id": "section_label",
          "component": "Text",
          "variant": "caption",
          "text": "Food items"
        },
        {
          "id": "progress_divider",
          "component": "Divider"
        },
        {
          "id": "meal_tag",
          "component": "IconBadge",
          "name": "{{mealIcon}}",
          "label": "{{mealType}}",
          "color": "{{mealColor}}",
          "background": "{{mealBackground}}"
        },
        {
          "id": "title",
          "component": "Text",
          "variant": "h2",
          "text": "What did you have for {{mealType|lower}}?"
        },
        {
          "id": "subtitle",
          "component": "Text",
          "variant": "body",
          "text": "Tap everything that was on your plate, or add your own."
        },
        {
          "id": "suggestions_header",
          "component": "Row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            "suggestions_label",
            "selected_count"
          ]
        },
        {
          "id": "suggestions_label",
          "component": "Text",
          "variant": "h4",
          "text": "SUGGESTIONS"
        },
        {
          "id": "selected_count",
          "component": "Text",
          "variant": "caption",
          "text": {
            "call": "formatString",
            "args": {
              "value": "${length(value:${/foodItems})} selected"
            },
            "returnType": "string"
          }
        },
        {
          "id": "picked",
          "component": "ChoicePicker",
          "variant": "multipleSelection",
          "displayStyle": "chips",
          "value": {
            "path": "/foodItems"
          },
          "options": {
            "$ai": "6 foods people often eat for the meal type the user just picked (the mealType in their last action): breakfast foods for breakfast, light bites for a snack, and so on. A varied mix of everyday dishes, including Indian home cooking. Short names (1–3 words), no quantities. Pick a different set each time.",
            "example": [
              {
                "label": "Rice",
                "value": "Rice"
              },
              {
                "label": "Dal",
                "value": "Dal"
              },
              {
                "label": "Roti",
                "value": "Roti"
              },
              {
                "label": "Salad",
                "value": "Salad"
              },
              {
                "label": "Paneer",
                "value": "Paneer"
              },
              {
                "label": "Curd",
                "value": "Curd"
              }
            ]
          }
        },
        {
          "id": "other_card",
          "component": "Card",
          "child": "other_content"
        },
        {
          "id": "other_content",
          "component": "Column",
          "align": "stretch",
          "children": [
            "other_title",
            "other",
            "other_hint"
          ]
        },
        {
          "id": "other_title",
          "component": "Text",
          "variant": "h5",
          "text": "Something else?"
        },
        {
          "id": "other",
          "component": "TextField",
          "label": "e.g. Oatmeal, eggs",
          "value": {
            "path": "/otherFood"
          }
        },
        {
          "id": "other_hint",
          "component": "Text",
          "variant": "caption",
          "text": "Separate several foods with commas."
        },
        {
          "id": "next",
          "component": "Button",
          "variant": "primary",
          "child": "next_content",
          "action": {
            "event": {
              "name": "foodItemsEntered",
              "context": {
                "foodItems": {
                  "path": "/foodItems"
                },
                "otherFood": {
                  "path": "/otherFood"
                }
              }
            }
          },
          "checks": [
            {
              "condition": {
                "call": "regex",
                "args": {
                  "value": {
                    "call": "formatString",
                    "args": {
                      "value": "${length(value:${/foodItems})}${/otherFood}"
                    },
                    "returnType": "string"
                  },
                  "pattern": "^(?!0\\s*$)."
                },
                "returnType": "boolean"
              },
              "message": "Pick or type at least one food"
            }
          ]
        },
        {
          "id": "next_content",
          "component": "Row",
          "justify": "center",
          "align": "center",
          "children": [
            "next_label",
            "next_icon"
          ]
        },
        {
          "id": "next_label",
          "component": "Text",
          "text": {
            "call": "formatString",
            "args": {
              "value": "Continue · ${length(value:${/foodItems})} ${pluralize(value:${length(value:${/foodItems})}, one:'item', other:'items')}"
            },
            "returnType": "string"
          }
        },
        {
          "id": "next_icon",
          "component": "Icon",
          "name": "arrowForward"
        }
      ]
    }
  }
]
