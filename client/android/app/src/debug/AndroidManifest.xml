<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Allows plain HTTP for Android's own network stack (e.g. media
         players) in debug builds. The app's calls to the local Python backend
         (http://10.0.2.2:10002 from the emulator) go through Dart's HTTP
         client, which this setting doesn't affect, so they work in every
         build type. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
